<?xml version="1.0" encoding="utf-8"?>
<!--
  临时联调配置（2026-08-29 起）。

  只为 APP 后端的这台机器放行明文 HTTP，其余流量仍然强制 HTTPS —— 所以这里用
  domain-config 而不是 application 上的 usesCleartextTraffic="true"。
  后端恢复可用的 HTTPS 源站后，本文件与 AndroidManifest 里的
  android:networkSecurityConfig 引用要一起删掉。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">120.25.227.36</domain>
    </domain-config>
</network-security-config>
