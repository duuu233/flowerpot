<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Flutter launch window.

  It repaints AppPageBackground.home's gradient (lib/src/design_system/widgets/
  layout/app_page_scaffold.dart) so the hand-off to SplashPage's first frame is
  seamless. The default white here was visible as a flash before the mint
  background appeared.

  bg01.png is deliberately not drawn: Flutter scales it with BoxFit.fitWidth
  anchored to the top, and a layer-list <bitmap> can only stretch (fill) or
  center — either one shifts the orbit artwork, which is more noticeable than
  having it fade in with the first frame.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#EFF7F8"
                android:endColor="#FAFAFA"
                android:startColor="#F8FBFB"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
