<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <!-- EZ（SmartConfig）把 SSID 和密码编码成 UDP 组播发给设备。Android 要收发
         组播必须先拿 WifiManager.MulticastLock，而申请这个锁需要本权限；没有它，
         Wi-Fi 芯片在省电模式下会直接丢掉组播帧，配网只会等满 120 秒后报
         `1006 out of time`，看不出是权限缺失。normal 级权限，装机即授予。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- 蓝牙（双模配网）。Android 11 及以下用这两个传统权限，都是 normal 级、装机即授予；
         12 起被 BLUETOOTH_SCAN / BLUETOOTH_CONNECT 取代，所以加 maxSdkVersion 收口。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <!-- ⚠️ **这里刻意不加 `neverForLocation`**（2026-09-11 真机扫不到设备之后改的）。
         加上那个标志确实可以在 Android 12+ 免掉定位权限，但代价是**系统会过滤扫描结果**：
         凡是可能被用来推断位置的广播（iBeacon 这一类）都被剔掉，应用根本收不到。涂鸦官方
         口径也是这么说的——「可选仅用 BLUETOOTH_SCAN（带 neverForLocation），无需定位权限，
         **除非需扫描 iBeacon 类广播**」。待配网设备广播的正是这类厂商自定义数据，带着这个
         标志很可能一台都扫不出来，而且**不报错、静默为空**，跟"设备没开机"完全分不开。
         去掉它之后 12+ 需要同时授予 ACCESS_FINE_LOCATION，权限请求那边已按版本分支处理。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Smart Life App SDK must be initialized from Application.onCreate, so the
         app declares its own Application class instead of Flutter's
         applicationName placeholder. FlowerpotApplication extends
         android.app.Application, which is what that placeholder resolves to for
         the v2 embedding. -->
    <application
        android:label="智能花盆"
        android:name=".FlowerpotApplication"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher">
        <meta-data android:name="THING_SMART_APPKEY" android:value="${tuyaAppKey}" />
        <meta-data android:name="THING_SMART_SECRET" android:value="${tuyaAppSecret}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
